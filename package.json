{
  "name": "prof-test",
  "version": "0.1.0",
  "description": "Cross-platform LaTeX test generator (prototype)",
  "packageManager": "bun@1.1.38",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && bun run renderer:build && bun run renderer:prepare",
    "start": "node dist/main.js",
    "dev": "bun run electron:dev",
    "main:watch": "tsc -w",
    "electron:build": "bun run build && electron .",
    "electron:dev": "cross-env ELECTRON_DEV=1 concurrently \"bun run main:watch\" \"bun run renderer:dev\" \"bun run electron:run\"",
    "electron:run": "electron .",
    "renderer:build": "bunx next build src/renderer",
    "renderer:dev": "bunx next dev src/renderer -p 3000",
    "renderer:prepare": "node scripts/copy-renderer-out.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo \"No linter configured\" && exit 0"
  },
  "vitest": {
    "environment": "jsdom"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/electron": "^1.4.38",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^26.0.0",
    "jsdom": "^27.2.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "next": "canary",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "better-sqlite3": "^8.4.0"
  }
}
